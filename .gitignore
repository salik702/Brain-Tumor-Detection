# ==============================================================================
# Brain Tumor Detection - Git Ignore Configuration
# ==============================================================================

# --- Python & Compiled Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.manifest
*.spec

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
pip-selfcheck.json

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
.ipython/

# --- Machine Learning Models & Large Weights ---
# (ML models and weights are often too large for GitHub (>50MB/100MB limits))
*.h5
*.keras
*.pkl
*.joblib
*.pb
*.onnx
*.pt
*.pth
*.ckpt

# --- Datasets & Data Folders ---
# (Exclude raw/processed datasets to keep repo lightweight and avoid storage limits)
Brain_Tumor_Data/
data/
dataset/
datasets/
temp_data/

# --- Node / Frontend (React Client) ---
node_modules/
/client/node_modules/
/client/build/
/client/dist/
/client/.env*.local

# --- IDEs & Text Editors ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.project
.pydevproject
.settings/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Logs & Diagnostics ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment Variables & Sensitive Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.backup
*.env
